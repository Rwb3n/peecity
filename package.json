    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "ingest": "tsx scripts/ingest-cli.ts",
    "validate:schemas": "jest --config jest.schema.config.js tests/performance/schema_validation_benchmark_test.js",
    "validate:schemas:ci": "jest --config jest.schema.config.js tests/performance/schema_validation_benchmark_test.js --ci --silent",
    "validate:data": "jest --config jest.schema.config.js tests/schemas/ --testPathPattern=_test.js",
    "validate:data:ci": "jest --config jest.schema.config.js tests/schemas/ --testPathPattern=_test.js --ci --silent",
    "validate:integrity": "node scripts/validate-schema-integrity.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook"
  },
