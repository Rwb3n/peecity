# Environment Configuration Template
# Copy this file to .env.local and update with your actual values

# Application Settings
NODE_ENV={{NODE_ENV}}
NEXT_PUBLIC_APP_NAME={{APP_NAME}}
NEXT_PUBLIC_APP_URL={{APP_URL}}

# Database Configuration (if applicable)
# DATABASE_URL={{DATABASE_URL}}
# DATABASE_NAME={{DATABASE_NAME}}

# API Keys and External Services
# Add your API keys here - never commit real values to version control
# EXTERNAL_API_KEY={{EXTERNAL_API_KEY}}
# THIRD_PARTY_SERVICE_URL={{THIRD_PARTY_SERVICE_URL}}

# Development Settings
# NEXT_PUBLIC_DEBUG_MODE={{DEBUG_MODE}}
# LOG_LEVEL={{LOG_LEVEL}}

# Monitoring and Analytics (if applicable)
# MONITORING_API_KEY={{MONITORING_API_KEY}}
# ANALYTICS_ID={{ANALYTICS_ID}}

# Security Settings
# JWT_SECRET={{JWT_SECRET}}
# ENCRYPTION_KEY={{ENCRYPTION_KEY}}

# Feature Flags (if applicable)
# FEATURE_FLAG_NAME={{FEATURE_FLAG_VALUE}}

# Performance Settings
# CACHE_TTL={{CACHE_TTL}}
# MAX_REQUEST_SIZE={{MAX_REQUEST_SIZE}}

# Note: 
# - Use NEXT_PUBLIC_ prefix for variables that need to be available in the browser
# - Keep sensitive values in .env.local (which should be in .gitignore)
# - Document all variables in your project README.md